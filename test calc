<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Calculate courier service rewards with the DSHX Courier Calculator for Blockade Runners, Deep Space Transports, and Freighters.">
    <title>DSHX Courier Calculator - Ship Class Rewards</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #FFFFFF;
            line-height: 1.6;
            min-height: 100vh;
        }

        header {
            background: linear-gradient(90deg, #0f3460 0%, #16213e 100%);
            border-bottom: 3px solid #FFC107;
            padding: 20px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        }

        header img {
            max-width: 80px;
            margin-bottom: 10px;
        }

        h1 {
            color: #FFC107;
            font-size: 2.5rem;
            margin-bottom: 5px;
            text-shadow: 0 2px 10px rgba(255, 193, 7, 0.3);
        }

        .tagline {
            color: #E0E0E0;
            font-size: 0.95rem;
            font-weight: 300;
            letter-spacing: 1px;
        }

        header nav {
            margin-top: 15px;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        header nav a {
            color: #FFC107;
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            position: relative;
        }

        header nav a:hover {
            color: #FFD54F;
        }

        header nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: #FFC107;
            transition: width 0.3s ease;
        }

        header nav a:hover::after {
            width: 100%;
        }

        main {
            max-width: 1400px;
            margin: 40px auto;
            padding: 20px;
        }

        .ship-classes-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .ship-card {
            background: linear-gradient(135deg, #16213e 0%, #0f3460 100%);
            border: 2px solid #FFC107;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 8px 30px rgba(255, 193, 7, 0.15);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .ship-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #FFC107, #FFD54F, #FFC107);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .ship-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(255, 193, 7, 0.25);
        }

        .ship-class-header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(255, 193, 7, 0.3);
        }

        .ship-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #FFC107, #FFD54F);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 28px;
        }

        .ship-info h2 {
            color: #FFC107;
            font-size: 1.8rem;
            margin-bottom: 5px;
        }

        .ship-specs {
            font-size: 0.85rem;
            color: #B0BEC5;
            margin-top: 5px;
        }

        .ship-specs-item {
            display: flex;
            justify-content: space-between;
            margin: 3px 0;
        }

        .max-cargo {
            color: #FFC107;
            font-weight: bold;
        }

        .security-zones {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }

        .zone {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        .zone.lowsec {
            background: #FF6B6B;
            color: #FFFFFF;
        }

        .zone.nullsec {
            background: #FF4757;
            color: #FFFFFF;
        }

        .zone.highsec {
            background: #2ED573;
            color: #FFFFFF;
        }

        form {
            margin-top: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            color: #E0E0E0;
            font-size: 0.95rem;
        }

        input[type="number"],
        select {
            width: 100%;
            padding: 12px;
            background: rgba(255, 193, 7, 0.05);
            border: 1.5px solid #FFC107;
            border-radius: 8px;
            color: #FFFFFF;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        input[type="number"]::placeholder,
        select {
            color: #B0BEC5;
        }

        input[type="number"]:focus,
        select:focus {
            outline: none;
            border-color: #FFD54F;
            box-shadow: 0 0 15px rgba(255, 193, 7, 0.4);
            background: rgba(255, 193, 7, 0.1);
        }

        select option {
            background: #16213e;
            color: #FFFFFF;
        }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #FFC107, transparent);
            margin: 20px 0;
        }

        .discount-section {
            background: rgba(255, 193, 7, 0.05);
            border: 1px solid rgba(255, 193, 7, 0.2);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .discount-section label {
            margin-bottom: 8px;
        }

        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(90deg, #FFC107, #FFD54F);
            color: #1a1a2e;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3);
        }

        button:active {
            transform: translateY(0);
        }

        .result {
            margin-top: 20px;
            padding: 20px;
            background: linear-gradient(135deg, rgba(255, 193, 7, 0.1), rgba(255, 193, 7, 0.05));
            border: 2px solid #FFC107;
            border-radius: 8px;
            text-align: center;
            display: none;
        }

        .result.show {
            display: block;
            animation: slideIn 0.4s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .result-label {
            color: #B0BEC5;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .result-value {
            color: #FFC107;
            font-size: 2rem;
            font-weight: bold;
            text-shadow: 0 2px 10px rgba(255, 193, 7, 0.3);
        }

        .discount-message {
            margin-top: 15px;
            padding: 12px;
            border-radius: 6px;
            font-weight: bold;
            text-align: center;
            font-size: 0.9rem;
        }

        .discount-success {
            background: rgba(46, 213, 115, 0.2);
            color: #2ED573;
            border: 1px solid #2ED573;
        }

        .discount-fail {
            background: rgba(255, 107, 107, 0.2);
            color: #FF6B6B;
            border: 1px solid #FF6B6B;
        }

        .disclaimer {
            margin-top: 15px;
            font-size: 0.8rem;
            color: #90CAF9;
            text-align: center;
            font-style: italic;
        }

        .error-message {
            background: rgba(255, 107, 107, 0.2);
            color: #FF6B6B;
            border: 1px solid #FF6B6B;
            padding: 12px;
            border-radius: 6px;
            margin-top: 15px;
            display: none;
        }

        .error-message.show {
