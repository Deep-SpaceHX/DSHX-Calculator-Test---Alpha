    <script>
        // Map trusted entity to its secret code and discount percent
        const trustedDiscounts = {
            "player1": { code: "Amynthia2!", discount: 0.02 }, // 2% discount
            "player2": { code: "VanDolay10!", discount: 0.10 }, // 10% discount
            "player3": { code: "Camarr!", discount: 0.05 }, // 5% discount
            "player4": { code: "PROFIT10!", discount: 0.02 }, // 2% discount
            "player5": { code: "Reaper!", discount: 0.05 }, // 5% discount
            "corp1": { code: "Loyal10!", discount: 0.10 }  // 10% discount
        };

        // Ship configuration with max cargo and allowed security zones
        const shipConfig = {
            blockade: {
                maxCargo: 11500,
                maxReward: 150_000_000,
                securityZones: ['lowSec', 'nullSec'],
                prefixes: {
                    jumps: 'blockadeJumps',
                    volume: 'blockadeVolume',
                    collateral: 'blockadeCollateral',
                    expedited: 'blockadeExpedited',
                    lowSec: 'blockadeLowSec',
                    nullSec: 'blockadeNullSec',
                    tip: 'blockadeTip',
                    trusted: 'blockadeTrusted',
                    code: 'blockadeCode',
                    error: 'blockadeError',
                    discount: 'blockadeDiscount',
                    result: 'blockadeResult',
                    resultValue: 'blockadeResultValue'
                }
            },
            dst: {
                maxCargo: 62500,
                maxReward: 150_000_000,
                securityZones: ['lowSec', 'nullSec'],
                prefixes: {
                    jumps: 'dstJumps',
                    volume: 'dstVolume',
                    collateral: 'dstCollateral',
                    expedited: 'dstExpedited',
                    lowSec: 'dstLowSec',
                    nullSec: 'dstNullSec',
                    tip: 'dstTip',
                    trusted: 'dstTrusted',
                    code: 'dstCode',
                    error: 'dstError',
                    discount: 'dstDiscount',
                    result: 'dstResult',
                    resultValue: 'dstResultValue'
                }
            },
            freighter: {
                maxCargo: 845000,
                maxReward: 150_000_000,
                securityZones: ['highSec'],
                prefixes: {
                    jumps: 'freighterJumps',
                    volume: 'freighterVolume',
                    collateral: 'freighterCollateral',
                    expedited: 'freighterExpedited',
                    tip: 'freighterTip',
                    trusted: 'freighterTrusted',
                    code: 'freighterCode',
                    error: 'freighterError',
                    discount: 'freighterDiscount',
                    result: 'freighterResult',
                    resultValue: 'freighterResultValue'
                }
            }
        };

        function calculateReward(shipType) {
            const config = shipConfig[shipType];
            const p = config.prefixes;

            // Get input values
            const jumps = parseFloat(document.getElementById(p.jumps).value);
            const volume = parseFloat(document.getElementById(p.volume).value);
            const collateral = parseFloat(document.getElementById(p.collateral).value);
            const expedited = document.getElementById(p.expedited).value === 'yes';
            let tip = parseFloat(document.getElementById(p.tip).value) || 0;

            // Security zones
            let lowSec = false, nullSec = false;
            if (config.securityZones.includes('lowSec')) {
                lowSec = document.getElementById(p.lowSec).value === 'yes';
            }
            if (config.securityZones.includes('nullSec')) {
                nullSec = document.getElementById(p.nullSec).value === 'yes';
            }

            // Trusted & discount
            const trusted = document.getElementById(p.trusted).value;
            const code = document.getElementById(p.code).value.trim();
            const errorEl = document.getElementById(p.error);
            const discountEl = document.getElementById(p.discount);
            const resultEl = document.getElementById(p.result);

            // Clear previous messages
            errorEl.classList.remove('show');
            discountEl.textContent = '';
            resultEl.classList.remove('show');

            // Validation
            if (isNaN(jumps) || isNaN(volume) || isNaN(collateral) || jumps <= 0 || volume <= 0 || collateral <= 0) {
                errorEl.textContent = '❌ Please enter valid numbers for all required fields.';
                errorEl.classList.add('show');
                return;
            }

            if (volume > config.maxCargo) {
                errorEl.textContent = `❌ Cargo exceeds maximum of ${config.maxCargo.toLocaleString()} m³ for this ship class.`;
                errorEl.classList.add('show');
                return;
            }

            // Calculate reward using tiered system
            let perJumpReward = 0;
            if (collateral < 1e9) {
                perJumpReward = 850000;
            } else if (collateral < 2e9) {
                perJumpReward = 1000000;
            } else if (collateral < 3e9) {
                perJumpReward = 2000000;
            } else if (collateral < 4e9) {
                perJumpReward = 3000000;
            } else if (collateral < 5e9) {
                perJumpReward = 4000000;
            } else if (collateral < 6e9) {
                perJumpReward = 5000000;
            } else if (collateral < 7e9) {
                perJumpReward = 6000000;
            } else if (collateral < 8e9) {
                perJumpReward = 7000000;
            } else if (collateral < 9e9) {
                perJumpReward = 8000000;
            } else if (collateral < 10e9) {
                perJumpReward = 9000000;
            } else {
                perJumpReward = 10000000;
            }

            let baseReward = perJumpReward * jumps;

            // Apply multipliers
            let multiplier = 1;
            if (expedited) multiplier *= 2.0;
            if (lowSec) multiplier *= 1.10;
            if (nullSec) multiplier *= 1.20;

            let reward = baseReward * multiplier;

            // Apply discount if code matches
            let discount = 0;
            if (trusted && trustedDiscounts[trusted]) {
                if (code && code === trustedDiscounts[trusted].code) {
                    discount = trustedDiscounts[trusted].discount;
                    reward = reward * (1 - discount);
                    discountEl.textContent = `✓ Discount applied: ${(discount * 100).toFixed(0)}% off!`;
                    discountEl.classList.add('discount-success');
                } else if (code) {
                    discountEl.textContent = `✗ Invalid secret code for selected corp/player.`;
                    discountEl.classList.add('discount-fail');
                }
            }

            // Add tip
            reward += tip;

            // Cap reward
            if (reward > config.maxReward) reward = config.maxReward;

            // Display result
            document.getElementById(p.resultValue).textContent = Math.round(reward).toLocaleString() + ' ISK';
            resultEl.classList.add('show');
        }
    </script>
</body>
</html>
