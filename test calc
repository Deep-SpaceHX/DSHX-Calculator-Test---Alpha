        .footer-text {
            margin: 5px 0;
            font-size: 0.95rem;
        }

        .footer-accent {
            color: #FFC107;
            font-weight: bold;
        }

        @media (max-width: 768px) {
            h1 {
                font-size: 1.8rem;
            }

